{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.yasapps.com"
        }
      ],
      "destination": "https://yasapps.com/:path*",
      "permanent": true
    },
    {
      "source": "/downloads/Yas-Browser-0.4.5-Windows-x64.exe",
      "destination": "https://github.com/alharthi8/yas-browser/releases/download/v0.4.6/Yas-0.4.6-Setup-x64.exe",
      "permanent": false
    },
    {
      "source": "/downloads/Yas-Mail-0.3.0-Windows-x64.exe",
      "destination": "https://github.com/alharthi8/yas-mail/releases/download/v0.3.1/Yas.Mail_0.3.1_x64-setup.exe",
      "permanent": false
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
